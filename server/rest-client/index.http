@baseUrl = http://localhost:4000
@token = <paste-login-token-here>

GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

###

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
	"email": "evaluate-user@example.com",
	"name": "Evaluate User"
}

###

GET {{baseUrl}}/api/messages
Authorization: Bearer {{token}}

###

POST {{baseUrl}}/api/messages
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"content": "Hello from REST client"
}

###

PUT {{baseUrl}}/api/messages/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"content": "Edited message content"
}

###

DELETE {{baseUrl}}/api/messages/1
Authorization: Bearer {{token}}

###

POST {{baseUrl}}/api/typing
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"isTyping": true
}

###

GET {{baseUrl}}/api/team-draft
Authorization: Bearer {{token}}

###

# body.update is a base64-encoded Yjs update (V1)
# body.baseRevision must match the current draft revision
POST {{baseUrl}}/api/team-draft
Content-Type: application/json
Authorization: Bearer {{token}}

{
	"update": "<base64-yjs-update>",
	"baseRevision": 0
}

###

GET {{baseUrl}}/events/messages?token={{token}}
